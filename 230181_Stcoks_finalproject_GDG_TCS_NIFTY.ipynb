      "NIFTY 50 train 2015-01-29 -> 2023-01-27 (1969 days) | test 2023-01-30 -> 2025-01-29 (493 days)\n",
      "TCS      train 2015-01-29 -> 2023-01-25 (1975 days) | test 2023-01-27 -> 2025-01-29 (494 days)\n"
     ]
