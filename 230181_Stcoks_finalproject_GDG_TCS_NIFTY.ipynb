   "source": [
    "correction = {}\n",
    "for name in prices:\n",
    "    n, N = split[name], len(y[name])\n",
    "    e = resid[name]\n",
    "    mu, sd = e[BURN_IN:n].mean(), e[BURN_IN:n].std()\n",
    "    z = (e - mu) / sd\n",
    "    days = np.arange(BURN_IN + WINDOW, N)                        # day d is predicted from residuals d-10 .. d-1\n",
    "    X = np.stack([z[d - WINDOW:d] for d in days])[..., None]\n",
    "    target = z[days]\n",
    "    train_pos = np.where(days < n)[0]\n",
    "    n_val = int(0.15 * len(train_pos))\n",
    "    tr, va, te = train_pos[:-n_val], train_pos[-n_val:], np.where(days >= n)[0]\n",
    "\n",
    "    models = [train_lstm(X[tr], target[tr], X[va], target[va], seed)[0] for seed in range(N_SEEDS)]\n",
    "    correction[name] = np.mean([predict(m, X[te]) for m in models], axis=0) * sd + mu\n",
    "    print(f\"{name:8s} trained {N_SEEDS} LSTMs on {len(tr)} windows ({len(va)} held out for early stopping), \"\n",
    "          f\"predicted {len(te)} test days\")"
   ]
  },
