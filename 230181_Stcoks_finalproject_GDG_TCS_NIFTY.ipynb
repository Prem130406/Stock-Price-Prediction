   ],
   "source": [
    "split = {name: int(TRAIN_FRAC * len(s)) for name, s in prices.items()}\n",
    "for name, s in prices.items():\n",
    "    n = split[name]\n",
    "    print(f\"{name:8s} train {s.index[0].date()} -> {s.index[n - 1].date()} ({n} days) | \"\n",
    "          f\"test {s.index[n].date()} -> {s.index[-1].date()} ({len(s) - n} days)\")"
   ]
  },
