   "source": [
    "forecasts, rows = {}, []\n",
    "for name, s in prices.items():\n",
    "    n = split[name]\n",
    "    actual, prev = s.to_numpy()[n:], s.to_numpy()[n - 1:-1]\n",
    "    mase_scale = np.mean(np.abs(np.diff(s.to_numpy()[:n])))\n",
    "    arima = onestep[name][n:]\n",
    "    forecasts[name] = {\"Naive (tomorrow = today)\": prev,\n",
    "                       f\"ARIMA{ORDER} (baseline)\": arima,\n",
    "                       \"ARIMA + LSTM (hybrid)\": arima + correction[name]}\n",
    "    move = actual - prev\n",
    "    for label, pred in forecasts[name].items():\n",
    "        err = actual - pred\n",
    "        rows.append({\"series\": name, \"model\": label,\n",
    "                     \"RMSE\": np.sqrt(np.mean(err ** 2)),\n",
    "                     \"MAPE %\": 100 * np.mean(np.abs(err) / actual),\n",
    "                     \"MASE\": np.mean(np.abs(err)) / mase_scale,\n",
    "                     \"Direction hit %\": np.nan if label.startswith(\"Naive\") else\n",
    "                         100 * np.mean(np.sign(pred - prev)[move != 0] == np.sign(move)[move != 0])})\n",
    "\n",
    "results = pd.DataFrame(rows).set_index([\"series\", \"model\"])\n",
    "results.round(3)"
   ]
  },
