   "cell_type": "markdown",
   "id": "385c6be6",
   "metadata": {},
   "source": [
    "# NIFTY 50 & TCS closing-price forecast: ARIMA + LSTM on residuals\n",
    "\n",
    "This notebook uses 10 years of daily closes from yfinance, split 80/20 in time order.\n",
    "ARIMA gives a one-day-ahead base forecast. An LSTM in PyTorch reads 10-step windows of normalised ARIMA residuals and predicts the next residual, and that prediction is added to the base forecast."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e4217031",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-08T11:43:27.454191Z",
     "iopub.status.busy": "2026-10-08T11:43:27.453196Z",
     "iopub.status.idle": "2026-10-08T11:43:31.649342Z",
     "shell.execute_reply": "2026-10-08T11:43:31.648834Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "numpy 2.4.6 | pandas 3.0.6 | statsmodels 0.15.0 | torch 2.14.1+cpu | yfinance 1.7.0\n"
     ]
    }
   ],
   "source": [
    "import copy\n",
    "import random\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import statsmodels\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import yfinance as yf\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "from statsmodels.tsa.stattools import adfuller, acf, pacf\n",
    "from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", message=\"adfuller currently returns\")\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "TICKERS = {\"NIFTY 50\": \"^NSEI\", \"TCS\": \"TCS.NS\"}\n",
    "START, END = \"2015-01-29\", \"2025-01-30\"  # 10 years; END is exclusive\n",
    "TRAIN_FRAC, D, WINDOW, BURN_IN, N_SEEDS = 0.8, 2, 10, 20, 5\n",
    "DATA_DIR = Path(\"data\")\n",
    "plt.rcParams.update({\"figure.figsize\": (14, 4), \"axes.grid\": True, \"grid.alpha\": 0.3})\n",
    "\n",
    "print(f\"numpy {np.__version__} | pandas {pd.__version__} | statsmodels {statsmodels.__version__} | \"\n",
    "      f\"torch {torch.__version__} | yfinance {yf.__version__}\")"
   ]
  },
