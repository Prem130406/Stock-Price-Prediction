   "source": [
    "def load_close(ticker):\n",
    "    # Adjusted daily close, cached to CSV so reruns use identical data\n",
    "    DATA_DIR.mkdir(exist_ok=True)\n",
    "    path = DATA_DIR / f\"{ticker.lstrip('^')}_{START}_{END}.csv\"\n",
    "    if path.exists():\n",
    "        close = pd.read_csv(path, index_col=0, parse_dates=True).squeeze(\"columns\")\n",
    "    else:\n",
    "        close = yf.download(ticker, start=START, end=END, auto_adjust=True, progress=False)[\"Close\"].squeeze(\"columns\")\n",
    "        close.to_csv(path)\n",
    "    return close.dropna().rename(ticker)\n",
    "\n",
    "\n",
    "prices = {name: load_close(t) for name, t in TICKERS.items()}\n",
    "pd.DataFrame({name: s.describe() for name, s in prices.items()}).round(2)"
   ]
  },
