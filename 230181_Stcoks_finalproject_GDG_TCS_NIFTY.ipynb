  {
   "cell_type": "markdown",
   "id": "8f7c784b",
   "metadata": {},
   "source": [
    "## LSTM on normalised ARIMA residuals\n",
    "* **Normalisation:** residuals are z-scored with the mean and standard deviation of the training residuals.\n",
    "* **Input:** the previous 10 residuals. **Target:** the next residual.\n",
    "* **Training:** only on training-period residuals. The last 15% of training windows are used for early stopping, and predictions are averaged over 5 seeds."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a118cb8f",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-08T11:43:32.790063Z",
     "iopub.status.busy": "2026-10-08T11:43:32.788386Z",
     "iopub.status.idle": "2026-10-08T11:43:32.821528Z",
     "shell.execute_reply": "2026-10-08T11:43:32.821528Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ResidualLSTM(\n",
      "  (lstm): LSTM(1, 32, batch_first=True)\n",
      "  (head): Linear(in_features=32, out_features=1, bias=True)\n",
      ")\n",
      "trainable parameters: 4513\n"
     ]
    }
   ],
   "source": [
    "class ResidualLSTM(nn.Module):\n",
    "    def __init__(self, hidden=32):\n",
    "        super().__init__()\n",
    "        self.lstm = nn.LSTM(input_size=1, hidden_size=hidden, batch_first=True)\n",
    "        self.head = nn.Linear(hidden, 1)\n",
    "\n",
    "    def forward(self, x):  # x: (batch, WINDOW, 1)\n",
    "        out, _ = self.lstm(x)\n",
    "        return self.head(out[:, -1]).squeeze(-1)\n",
    "\n",
    "\n",
    "def to_tensor(a):\n",
    "    return torch.tensor(np.asarray(a), dtype=torch.float32)\n",
    "\n",
    "\n",
    "def train_lstm(X_tr, y_tr, X_va, y_va, seed, epochs=300, patience=20, lr=1e-3, batch_size=64):\n",
    "    torch.manual_seed(seed)\n",
    "    model = ResidualLSTM()\n",
    "    opt = torch.optim.Adam(model.parameters(), lr=lr)\n",
    "    loss_fn, gen = nn.MSELoss(), torch.Generator().manual_seed(seed)\n",
    "    X_tr, y_tr, X_va, y_va = map(to_tensor, (X_tr, y_tr, X_va, y_va))\n",
    "    history, best, best_state, wait = [], np.inf, None, 0\n",
    "    for _ in range(epochs):\n",
    "        model.train()\n",
    "        total = 0.0\n",
    "        for idx in torch.randperm(len(X_tr), generator=gen).split(batch_size):\n",
    "            opt.zero_grad()\n",
    "            loss = loss_fn(model(X_tr[idx]), y_tr[idx])\n",
    "            loss.backward()\n",
    "            opt.step()\n",
    "            total += loss.item() * len(idx)\n",
    "        model.eval()\n",
    "        with torch.no_grad():\n",
    "            val = loss_fn(model(X_va), y_va).item()\n",
    "        history.append((total / len(X_tr), val))\n",
    "        if val < best - 1e-5:\n",
    "            best, best_state, wait = val, copy.deepcopy(model.state_dict()), 0\n",
    "        else:\n",
    "            wait += 1\n",
    "            if wait >= patience:\n",
    "                break\n",
    "    model.load_state_dict(best_state)\n",
    "    return model.eval(), np.array(history)\n",
    "\n",
    "\n",
    "def predict(model, X):\n",
    "    with torch.no_grad():\n",
    "        return model(to_tensor(X)).numpy()\n",
    "\n",
    "\n",
    "print(ResidualLSTM())\n",
    "print(\"trainable parameters:\", sum(p.numel() for p in ResidualLSTM().parameters()))"
   ]
  },
